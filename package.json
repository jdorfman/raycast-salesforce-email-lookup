{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "salesforce-email-lookup",
  "title": "Salesforce Email Lookup",
  "description": "Look up an email address in Salesforce. Enter opens the search in your browser, Cmd+Enter copies the URL.",
  "icon": "extension-icon.png",
  "author": "jdorfman",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "lookup-email",
      "title": "Salesforce Email Lookup",
      "subtitle": "Salesforce",
      "description": "Search Salesforce for an email address and open or copy the result URL.",
      "mode": "view",
      "arguments": [
        {
          "name": "email",
          "placeholder": "name@example.com",
          "type": "text",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "myDomain",
      "title": "Salesforce My Domain",
      "description": "The My Domain prefix for your org, e.g. acme for acme.lightning.force.com",
      "type": "textfield",
      "required": true
    },
    {
      "name": "defaultTarget",
      "title": "Default Action",
      "description": "Which URL Enter opens first.",
      "type": "dropdown",
      "required": false,
      "default": "lightning",
      "data": [
        {
          "title": "Lightning global search",
          "value": "lightning"
        },
        {
          "title": "Classic search, Contacts only",
          "value": "classicContacts"
        },
        {
          "title": "Classic search, Leads only",
          "value": "classicLeads"
        },
        {
          "title": "Classic search, all objects",
          "value": "classicAll"
        }
      ]
    }
  ],
  "dependencies": {
    "@raycast/api": "^2.0.3"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "22.19.17",
    "@types/react": "19.0.10",
    "eslint": "^9.39.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "build": "ray build -e dist -t release",
    "dev": "ray develop -t release",
    "fix-lint": "ray lint --fix -t release",
    "lint": "ray lint -t release",
    "publish": "npx @raycast/api@latest publish"
  }
}
